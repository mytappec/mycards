{
  "name": "tarjetas-sellos",
  "main": "index.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tarjetas-db",
      "database_id": "252fa7cf-0936-4ca6-bd91-913fefc3cb51"
    }
  ],
  "r2_buckets": [
    {
      "binding": "LOGOS_BUCKET",
      "bucket_name": "heytapp-logos"
    }
  ],
  "triggers": {
    "crons": ["0 13 * * *"]
  }
}
